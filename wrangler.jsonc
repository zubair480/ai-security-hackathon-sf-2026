{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "payeelock",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-13",
  "workers_dev": true,
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "PayeeLockContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "PAYEELOCK", "class_name": "PayeeLockContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PayeeLockContainer"] }]
}
